# PersonaPlex server (running on GPU instance)
PERSONAPLEX_HOST=localhost
PERSONAPLEX_PORT=8998
PERSONAPLEX_WS_PATH=/api/chat

# Voice settings
VOICE_PROMPT=VARF2.pt
AUDIO_TEMPERATURE=0.9
TEXT_TEMPERATURE=0.7

# Bridge server port
PORT=3001

# Claude API key for System 2 reasoning (optional — works without, just no smart decisions)
ANTHROPIC_API_KEY=
